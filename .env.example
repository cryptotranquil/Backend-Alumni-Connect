# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-at-least-32-random-characters
# Session length in minutes. The clock starts at sign-in and is not extended;
# when it runs out the user is signed out. Default 10.
SESSION_MINUTES=10

# Two-factor authentication: a 6-digit code is emailed (via Brevo below) after
# the password step. Set to "false" only for local work without email.
TWO_FACTOR_ENABLED=true

# Per-account login lockout (separate from the per-IP rate limiter below):
# after this many wrong passwords in a row for one account, it is locked for
# ACCOUNT_LOCK_MINUTES regardless of which IP is trying. Defaults: 10 / 15.
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=10

# React application URL (links in email and CORS).
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional browser origins.
CORS_ORIGIN=http://localhost:5173
# Public API URL used by the event reminder scheduler.
BASE_URL=http://localhost:5000
CRON_SECRET=replace-with-a-long-random-secret

# ── Firestore ─────────────────────────────────────────────────────────────────
# Raw JSON or base64-encoded Firebase service-account JSON. Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative: point Application Default Credentials at a local key file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-firebase-project-id
# Local emulator option (no credentials required):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# FIREBASE_PROJECT_ID=alumni-connect-local

# ── Optional initial administrator for `npm run seed` ─────────────────────────
# INITIAL_ADMIN_NAME=System Administrator
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=replace-with-a-secure-password

# ── Brevo transactional email ─────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Alumni Connect

#C3cr9PdgABBsaA1! ── Cloudinary (CV, avatar, and cover uploads) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=alumni-connect

SEED_SAMPLE_PASSWORD=Password123!

