{
  "name": "alumni-connect-backend",
  "version": "2.0.0",
  "description": "Alumni Connect API — Express, Firestore, JWT and Socket.IO",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "test:integration": "npx --yes firebase-tools@13.35.1 emulators:exec --only firestore --project alumni-connect-test \"node integration/api.integration.js\"",
    "seed": "node scripts/seed.js",
    "seed:collections": "node scripts/seedCollections.js",
    "init:schema": "node scripts/initFirestoreSchema.js"
  },
  "keywords": [
    "alumni",
    "express",
    "firestore"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
